{
  "info": {
    "name": "Notifications & Web-Push Module",
    "description": "Postman test collection for real-time notifications and Web-Push endpoints.\nIncludes listing notifications, marking read, marking all read, push subscription registration, and fetching VAPID public key.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "tenant_token", "value": "", "type": "string" },
    { "key": "sample_notification_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "01. Auth – Login as Tenant",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "const token = res.token || (res.data && res.data.token);",
              "if (token) {",
              "  pm.collectionVariables.set('tenant_token', token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"tenant@jptl.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "02. Notifications – Fetch VAPID Public Key",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('VAPID key returned', () => pm.expect(res.publicKey).to.be.a('string'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{tenant_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/notifications/vapid-key",
          "host": ["{{base_url}}"],
          "path": ["api", "notifications", "vapid-key"]
        }
      }
    },
    {
      "name": "03. Notifications – List User Notifications",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Notifications array returned', () => pm.expect(res.data).to.be.an('array'));",
              "if (res.data && res.data.length > 0) {",
              "  pm.collectionVariables.set('sample_notification_id', res.data[0]._id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{tenant_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/notifications",
          "host": ["{{base_url}}"],
          "path": ["api", "notifications"]
        }
      }
    },
    {
      "name": "04. Notifications – Mark All Notifications As Read",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Mark all read succeeded', () => pm.expect(res.success).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{tenant_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/notifications/read-all",
          "host": ["{{base_url}}"],
          "path": ["api", "notifications", "read-all"]
        }
      }
    },
    {
      "name": "05. Notifications – Register Web-Push Subscription",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Subscription registered', () => pm.expect(res.success).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{tenant_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"subscription\": {\n    \"endpoint\": \"https://fcm.googleapis.com/fcm/send/test-token-123\",\n    \"keys\": {\n      \"p256dh\": \"test-p256dh-key-value\",\n      \"auth\": \"test-auth-secret-value\"\n    }\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/notifications/subscribe",
          "host": ["{{base_url}}"],
          "path": ["api", "notifications", "subscribe"]
        }
      }
    }
  ]
}
