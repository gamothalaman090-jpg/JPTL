{
  "info": {
    "name": "Landlord – Vendor Directory Module",
    "description": "Postman test collection for Landlord Approved Maintenance Vendors CRUD endpoints.\nIncludes vendor listing, creation, updating, deletion, and role security guards.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "landlord_token", "value": "", "type": "string" },
    { "key": "tenant_token", "value": "", "type": "string" },
    { "key": "created_vendor_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "01. Auth – Login as Landlord",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "const token = res.token || (res.data && res.data.token);",
              "if (token) {",
              "  pm.collectionVariables.set('landlord_token', token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"landlord@jptl.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "02. Auth – Login as Tenant",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "const token = res.token || (res.data && res.data.token);",
              "if (token) {",
              "  pm.collectionVariables.set('tenant_token', token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"tenant@jptl.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "03. Vendor Directory – Create Vendor",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
              "pm.test('Vendor created successfully', () => pm.expect(res.success).to.be.true);",
              "if (res.data && res.data._id) {",
              "  pm.collectionVariables.set('created_vendor_id', res.data._id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{landlord_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"ProFix Electricals\",\n  \"category\": \"Electrical\",\n  \"contactPhone\": \"+1 (555) 777-8899\",\n  \"email\": \"profix@electric.com\",\n  \"company\": \"ProFix Electric Corp\",\n  \"contactPerson\": \"Dan Sparks\",\n  \"rating\": 4.8\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/landlord/vendors",
          "host": ["{{base_url}}"],
          "path": ["api", "landlord", "vendors"]
        }
      }
    },
    {
      "name": "04. Vendor Directory – List Vendors",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Vendors returned', () => pm.expect(res.data).to.be.an('array'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{landlord_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/landlord/vendors",
          "host": ["{{base_url}}"],
          "path": ["api", "landlord", "vendors"]
        }
      }
    },
    {
      "name": "05. Vendor Directory – Update Vendor",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Rating updated', () => pm.expect(res.data.rating).to.equal(5.0));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{landlord_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rating\": 5.0\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/landlord/vendors/{{created_vendor_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "landlord", "vendors", "{{created_vendor_id}}"]
        }
      }
    },
    {
      "name": "06. Security Guard – Tenant Forbidden",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 403 Forbidden', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{tenant_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Hacker Plumbing\",\n  \"category\": \"Plumbing\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/landlord/vendors",
          "host": ["{{base_url}}"],
          "path": ["api", "landlord", "vendors"]
        }
      }
    },
    {
      "name": "07. Vendor Directory – Delete Vendor",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Vendor deleted successfully', () => pm.expect(res.success).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{landlord_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/landlord/vendors/{{created_vendor_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "landlord", "vendors", "{{created_vendor_id}}"]
        }
      }
    }
  ]
}
