{
  "info": {
    "name": "Landlord – Audit Logs Viewer Module",
    "description": "Postman test collection for Landlord Security & Activity Audit Trail endpoints.\nIncludes listing logs, filtering by action, pagination, and role security guards.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "landlord_token", "value": "", "type": "string" },
    { "key": "tenant_token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "01. Auth – Login as Landlord",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "const token = res.token || (res.data && res.data.token);",
              "if (token) {",
              "  pm.collectionVariables.set('landlord_token', token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"landlord@jptl.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "02. Auth – Login as Tenant",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "const token = res.token || (res.data && res.data.token);",
              "if (token) {",
              "  pm.collectionVariables.set('tenant_token', token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"tenant@jptl.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "03. Audit Logs – List Landlord Audit Logs",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Logs returned', () => pm.expect(res.logs || (res.data && res.data.logs)).to.be.an('array'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{landlord_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/landlord/audit-logs",
          "host": ["{{base_url}}"],
          "path": ["api", "landlord", "audit-logs"]
        }
      }
    },
    {
      "name": "04. Audit Logs – Filter By Action",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Pagination object returned', () => pm.expect(res.pagination || (res.data && res.data.pagination)).to.be.an('object'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{landlord_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/landlord/audit-logs?action=LOGIN",
          "host": ["{{base_url}}"],
          "path": ["api", "landlord", "audit-logs"],
          "query": [
            { "key": "action", "value": "LOGIN" }
          ]
        }
      }
    },
    {
      "name": "05. Security Guard – Tenant Forbidden",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 403 Forbidden', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{tenant_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/landlord/audit-logs",
          "host": ["{{base_url}}"],
          "path": ["api", "landlord", "audit-logs"]
        }
      }
    }
  ]
}
